# Окружение для сборки прототипа. Ничего не ставится в систему хоста.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        qt6-base-dev \
        qt6-websockets-dev \
        zlib1g-dev \
        ffmpeg \
        gdb \
        # библиотеки, без которых Qt не поднимет окно через X11
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-shape0 \
        libxcb-xinerama0 \
        libxkbcommon-x11-0 \
        # звук для ffplay
        libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# Пользователь с теми же идентификаторами, что и на хосте: иначе собранные
# файлы окажутся во владении root и их не удалить без sudo.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} dev; \
    fi \
 && if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd -m -u ${HOST_UID} -g ${HOST_GID} -s /bin/bash dev; \
    fi \
 && mkdir -p /project && chown ${HOST_UID}:${HOST_GID} /project

USER ${HOST_UID}:${HOST_GID}
WORKDIR /project

ENV QT_LOGGING_RULES="qt.accessibility.atspi=false"
CMD ["/bin/bash"]
